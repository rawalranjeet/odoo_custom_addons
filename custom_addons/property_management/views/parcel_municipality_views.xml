<odoo>
   
    <record id="view_property_municipality_tree" model="ir.ui.view">
        <field name="name">property.municipality.list</field>
        <field name="model">property.municipality</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_property_municipality_form" model="ir.ui.view">
        <field name="name">property.municipality.form</field>
        <field name="model">property.municipality</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_municipality" model="ir.actions.act_window">
        <field name="name">Municipalities</field>
        <field name="res_model">property.municipality</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="menu_property_municipality" name="Municipalities"
              parent="menu_property_configuration"
              action="action_property_municipality"
              sequence="4"/>


   
    <record id="view_property_fema_flood_type_tree" model="ir.ui.view">
        <field name="name">property.fema.flood.type.list</field>
        <field name="model">property.fema.flood.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_property_fema_flood_type_form" model="ir.ui.view">
        <field name="name">property.fema.flood.type.form</field>
        <field name="model">property.fema.flood.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_fema_flood_type" model="ir.actions.act_window">
        <field name="name">FEMA Flood Types</field>
        <field name="res_model">property.fema.flood.type</field>
        <field name="view_mode">list,form</field>
    </record>

  
   
    <menuitem id="menu_property_fema_flood_type"
              name="FEMA Flood Types"
              parent="menu_property_configuration"
              action="action_property_fema_flood_type"
              sequence="5"/>
</odoo>
