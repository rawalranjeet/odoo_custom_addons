<odoo>
  <record id="view_form_property" model="ir.ui.view">
    <field name="name">property.form</field>
    <field name="model">property.property</field>
    <field name="arch" type="xml">
      <form string="Property">
        <sheet>
          <group>
            <field name="name" />
            <field name="partner_id" readonly="0" />
            <field name="sale_order_id" readonly="1" invisible="1" />
            <field name="parcel_id" />
          </group>
          <notebook>
            <page string="Rooms">
              <field name="property_room_line_ids" mode="list,kanban">
                <list>
                  <field name="room_id" />
                </list>
                <kanban editable="bottom">
                  <field name="room_id">
                  </field>
                  <templates>
                    <t t-name="kanban-box">
                      <div class="o_kanban_record">
                        <strong>
                          <field name="room_id" />
                        </strong>
                      </div>
                    </t>
                  </templates>
                </kanban>
                <form string="Rooms">
                  <group>
                    <field name="room_id" />
                    <field name="component_line_ids" mode="list,kanban">
                      <list editable="bottom">
                        <field name="component_id" />
                        <field name="length" />
                        <field name="height" />
                      </list>
                      <kanban>
                        <templates>
                          <t t-name="kanban-box">
                            <div class="o_kanban_record">
                              <strong>
                                <field name="component_id" />
                              </strong>
                              <br />
                              Length: <field name="length" /> m
                              <br />
                              Height: <field name="height" /> m
                            </div>
                          </t>
                        </templates>
                      </kanban>
                      <form string="Components">
                        <group>
                          <field name="component_id" />
                          <field name="length" />
                          <field name="height" />
                        </group>
                      </form>
                    </field>
                  </group>
                </form>
              </field>
            </page>
  
            <page string="Summary">
              <group>
                <field name="total_components" readonly="1" />
                <field name="total_area" readonly="1" />
                <field name="room_count" readonly="1" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="property_property_view_form_simplified" model="ir.ui.view">
    <field name="name">property.property.view.form.simplified</field>
    <field name="model">property.property</field>
    <field name="arch" type="xml">
        <form string="Project">
            <div class="oe_title mb-lg-3 mb-md-2">
                <label for="name" string="Name"/>
                <h1>
                    <field name="name" class="o_project_name" placeholder="e.g. Residential"/>
                </h1>
            </div>
            <group>
              <field name="partner_id"/>
            </group>
        </form>
    </field>
  </record>

  <record id="view_tree_property" model="ir.ui.view">
    <field name="name">property.tree</field>
    <field name="model">property.property</field>
    <field name="arch" type="xml">
      <list string="Properties">
        <field name="name" />
        <field name="partner_id" />
        <field name="sale_order_id" />
        <!-- <field name="total_components"/> -->
        <field name="total_area" />
      </list>
    </field>
  </record>

  <record id="view_kanban_property" model="ir.ui.view">
    <field name="name">property.kanban</field>
    <field name="model">property.property</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile"
      on_create="property_management.action_property_simplified"
      action="select_rooms" type="object">
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card">
              <strong>
                <field name="name" />
              </strong>
              <br />
              <field name="partner_id" />
              <br />
              <div style="margin-top: 10px;">
                <!-- Height -->
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold me-2">Height</span>
                  <div class="input-group" style="width: 120px;">
                    <button type="object" name="action_decrease_height" class="btn btn-dark fw-bold btn-purple">−</button>
                    <span class="form-control text-center border-dark bg-light fw-bold">
                      <field name="height"/>
                    </span>
                    <button type="object" name="action_increase_height" class="btn btn-dark fw-bold btn-purple">＋</button>
                  </div>
                </div>
              </div>
              Rooms: <field name="room_count" />
            <br /> Components: <field name="total_components" />
            <div>Total
              Area: <field name="total_area" /> m²</div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_property" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">property.property</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="view_kanban_property"/>
    <field name="target">current</field>
  </record>

  <record id="action_property_simplified" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">property.property</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="property_property_view_form_simplified"/>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_property_root" name="Properties" sequence="10" />
  <menuitem id="menu_property" name="Properties" parent="menu_property_root"
    action="action_property" sequence="1" />
  <menuitem id="menu_property_configuration" name="Configuration" parent="menu_property_root"
    sequence="3" />
</odoo>