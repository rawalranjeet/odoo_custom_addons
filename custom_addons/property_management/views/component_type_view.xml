<odoo>
    <!-- Tree/List View -->
    <record id="view_property_component_type_tree" model="ir.ui.view">
        <field name="name">property.component.type.tree</field>
        <field name="model">property.component.type</field>
        <field name="arch" type="xml">
            <list string="Components Types">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_property_component_type_form" model="ir.ui.view">
        <field name="name">property.component.type.form</field>
        <field name="model">property.component.type</field>
        <field name="arch" type="xml">
            <form string="Component Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_component_type" model="ir.actions.act_window">
        <field name="name">Components Types</field>
        <field name="res_model">property.component.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_property_component_type"
              name="Components Types"
              parent="menu_property_configuration"
              action="action_property_component_type"
              sequence="4"/>
</odoo>
