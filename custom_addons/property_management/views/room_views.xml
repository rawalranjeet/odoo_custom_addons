<odoo>
  <!-- Room list View -->
  <record id="view_list_room_room" model="ir.ui.view">
    <field name="name">property.room.room.list</field>
    <field name="model">property.room.room</field>
    <field name="arch" type="xml">
      <list string="Rooms">
        <field name="name"/>
        <field name="attachment_ids"/>
      </list>
    </field>
  </record>

  <!-- Room Form View -->
  <record id="view_form_room_room" model="ir.ui.view">
    <field name="name">property.room.room.form</field>
    <field name="model">property.room.room</field>
    <field name="arch" type="xml">
      <form string="Room">
        <group>
          <field name="name"/>
          <field name="quantity"/>
          <field name="height"/>
          <field name="width"/>
          <field name="notes"/>
          <field name="attachment_ids"/>
        </group>
      </form>
    </field>
  </record>

  <!-- Room Kanban View with Selection & Buttons -->
  <record id="view_room_room_kanban_select" model="ir.ui.view">
    <field name="name">property.room.room.kanban.select</field>
    <field name="model">property.room.room</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" action="select_components" type="object" create="false">
        <header>
          <button name="add_component_services" type="object" string="Add Services" class="oe_highlight" display="always" invisible="not context.get('order_id')"/>
<!--          <button name="add_component_services" type="object" string="Add Services" class="btn btn-secondary o-icon-button fa fa-home o_form_button oe_highlight" display="always" invisible="not context.get('order_id')"/>-->
<!--            <button name="action_manage_property" type="object" class="btn btn-secondary o-icon-button fa fa-home o_form_button oe_highlight"/>-->
        </header>
        <field name="name"/>
        <field name="property_name_char" invisible="1"/>
        <field name="height"/>
        <field name="quantity"/>
        <field name="notes"/>
        <field name="width"/>
        <field name="is_added" invisible="1"/>
        <field name="attachment_ids"/>
        <templates>
          <t t-name="kanban-box">
            <t t-set="is_added" t-value="record.is_added.raw_value"/>
            <t t-if="is_added">
              <div class="oe_kanban_card o_kanban_record">
                <div class="d-flex justify-content-between">
                  <strong><field name="name"/><a type="object" name="action_open_edit_name_wizard"><i class="fa fa-pencil text-primary ms-2" title="Edit"/></a></strong>
                  <button class="btn btn-success btn-sm" disabled="1">
                    <i class="fa fa-check"/> Added
                  </button>
                </div>

                <button type="object" name="action_upload_attachment">
                    <field name="property_id" invisible="1"/>
                    <field name="attachment_ids" widget="kanban_attachment_uploader"/>
                </button>

                <!-- Width & Height in Single Row -->
                <div style="margin-top: 10px;">
                  <!-- Quantity -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold me-2">Quantity</span>
                    <div class="input-group" style="width: 120px;">
                      <button type="object" name="action_decrease_quantity" class="btn btn-dark fw-bold btn-purple">−</button>
                      <span class="form-control text-center border-dark bg-light fw-bold">
                        <field name="quantity"/>
                      </span>
                      <button type="object" name="action_increase_quantity" class="btn btn-dark fw-bold btn-purple">＋</button>
                    </div>
                  </div>
                  <br/>
                  <!-- Length -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold me-2">Length</span>
                    <div class="input-group" style="width: 120px;">
                      <button type="object" name="action_decrease_length" class="btn btn-dark fw-bold btn-purple">−</button>
                      <span class="form-control text-center border-dark bg-light fw-bold">
                        <field name="length"/>
                      </span>
                      <button type="object" name="action_increase_length" class="btn btn-dark fw-bold btn-purple">＋</button>
                    </div>
                  </div>
                  <br/>
                  <!-- Width -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold me-2">Width</span>
                    <div class="input-group" style="width: 120px;">
                      <button type="object" name="action_decrease_width" class="btn btn-dark fw-bold btn-purple">−</button>
                      <span class="form-control text-center border-dark bg-light fw-bold">
                        <field name="width"/>
                      </span>
                      <button type="object" name="action_increase_width" class="btn btn-dark fw-bold btn-purple">＋</button>
                    </div>
                  </div>
                  <br/>
                  <!-- Height -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold me-2">Height</span>
                    <div class="input-group" style="width: 120px;">
                      <button type="object" name="action_decrease_height" class="btn btn-dark fw-bold btn-purple">−</button>
                      <span class="form-control text-center border-dark bg-light fw-bold">
                        <field name="height"/>
                      </span>
                      <button type="object" name="action_increase_height" class="btn btn-dark fw-bold btn-purple">＋</button>
                    </div>
                  </div>
                  <br/>
                  <!-- Notes -->
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold me-2">Notes<a type="object" name="action_open_edit_notes_wizard"><i class="fa fa-pencil text-primary ms-2" title="Edit"/></a></span>
                    <div class="input-group" style="width: 120px;">
                      <span class="form-control text-center border-dark bg-light fw-bold">
                        <field name="notes"/>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </t>
            <t t-else="">
              <div class="oe_kanban_card o_kanban_record">
                <div class="d-flex justify-content-between">
                  <strong><field name="name"/><a type="object" name="action_open_edit_name_wizard"><i class="fa fa-pencil text-primary ms-2" title="Edit"/></a></strong>
                  <button type="object" name="add_property_room" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"/> Add
                  </button>
                </div>
              </div>
            </t>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Room Kanban View (Generic) -->
  <record id="view_room_room_kanban" model="ir.ui.view">
    <field name="name">property.room.room.kanban</field>
    <field name="model">property.room.room</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="name"/>
        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record">
              <strong><field name="name"/></strong>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Kanban Selection Action -->
  <record id="action_property_room_kanaban" model="ir.actions.act_window">
    <field name="name">Rooms</field>
    <field name="res_model">property.room.room</field>
    <field name="view_mode">kanban,list</field>
    <field name="view_id" ref="view_room_room_kanban_select"/>
  </record>

  <!-- Normal Room Menu Action -->
  <record id="action_room_room" model="ir.actions.act_window">
    <field name="name">Rooms</field>
    <field name="res_model">property.room.room</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="view_room_room_kanban"/>
  </record>

  <!-- Menu -->
  <menuitem id="menu_room_room" name="Rooms" parent="menu_property_configuration" action="action_room_room" sequence="1"/>

    <record id="view_ir_attachment_upload_only" model="ir.ui.view">
        <field name="name">ir.attachment.upload.only.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Upload File">
                <sheet>
                    <group>
                        <!-- File Name -->
                        <field name="name" required="1"/>
                        <!-- File Upload -->
                        <field name="datas" string="Upload Attachment" filename="name" required="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>